# OpenAI 兼容接口。DeepSeek、通义、OpenAI 等把 base url 换成对应地址即可。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 可选。不填则首次运行时在本地数据库生成匿名标识，只用于 AIHOT 的 User-Agent。
# AIHOT_ACTOR_ID=

# 可选。默认 ./data/app.sqlite
# DATABASE_PATH=./data/app.sqlite

# 飞书自建应用。用应用身份的 tenant_access_token 写云文档，网页里不能改这两个值。
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# 可选。文档要放进某个共享文件夹时，填文件夹链接里 fld 开头的那一段。
# FEISHU_FOLDER_TOKEN=
